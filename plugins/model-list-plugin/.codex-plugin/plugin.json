{
  "name": "model-list-plugin",
  "version": "0.2.10",
  "description": "Synchronize remote OpenAI or Anthropic compatible model metadata into Codex and Claude Code.",
  "homepage": "https://github.com/ysdj/model-list-plugin",
  "repository": "https://github.com/ysdj/model-list-plugin",
  "license": "MIT",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${PLUGIN_ROOT}/bin/model-list-plugin\" hook --host codex --startup",
              "commandWindows": "\"${PLUGIN_ROOT}\\bin\\model-list-plugin.exe\" hook --host codex --startup"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${PLUGIN_ROOT}/bin/model-list-plugin\" hook --host codex",
              "commandWindows": "\"${PLUGIN_ROOT}\\bin\\model-list-plugin.exe\" hook --host codex"
            }
          ]
        }
      ]
    }
  }
}
