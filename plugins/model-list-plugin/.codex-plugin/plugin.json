{
  "name": "model-list-plugin",
  "version": "0.1.3",
  "description": "Synchronize remote OpenAI or Anthropic compatible model metadata into Codex and Claude Code.",
  "homepage": "https://github.com/ysdj/model-list-plugin",
  "repository": "https://github.com/ysdj/model-list-plugin",
  "license": "MIT",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/scripts/model-list-plugin.mjs\" hook --host codex",
              "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\model-list-plugin.mjs\" hook --host codex"
            }
          ]
        }
      ]
    }
  }
}
