{
  "description": "Refresh model-list-plugin projections when Claude Code starts or receives a prompt.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook --host claude --startup",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\bin\\model-list-plugin.exe\" hook --host claude --startup",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook --host claude",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\bin\\model-list-plugin.exe\" hook --host claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
