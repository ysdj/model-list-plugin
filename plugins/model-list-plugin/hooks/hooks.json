{
  "description": "Refresh model-list-plugin projections when Claude Code starts or receives a prompt.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/model-list-plugin.mjs",
              "hook",
              "--host",
              "claude"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/model-list-plugin.mjs",
              "hook",
              "--host",
              "claude"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
